import { NextResponse } from "next/server";

// Safe Default: Everything protected except public routes (/login, landing, webhooks, chat)
export default withAuth(
  function middleware(req) {
    const token = req.nextauth.token;
    const pathname = req.nextUrl.pathname;

    if ((pathname.startsWith("/dashboard") || pathname.startsWith("/admin")) && token?.role !== "ADMIN") {
      return NextResponse.redirect(new URL("/login?error=Forbidden", req.url));
    }
    if (pathname.startsWith("/agent") && !["ADMIN", "AGENT"].includes(token?.role as string)) {
      return NextResponse.redirect(new URL("/login?error=Forbidden", req.url));
    }
    return NextResponse.next();
  },
  {
    callbacks: {
      authorized: ({ token, req }) => {
        const path = req.nextUrl.pathname;
        if (
          path === "/login" ||
          path === "/" ||
          path.startsWith("/api/auth") ||
          path.startsWith("/api/webhooks") ||
          path.startsWith("/chat") ||
          path.startsWith("/api/chat-public") ||
          path.startsWith("/api/health")
        ) {
          return true;
        }
        return !!token;
      },
    },
    pages: { signIn: "/login" },
  }
);

export const config = {
  matcher: [
    "/dashboard/:path*",
    "/admin/:path*",
    "/agent/:path*",
    "/api/((?!auth|webhooks|chat-public|health).*)",
  ],
};
