.copy-btn { border: 1px solid var(--line); background: rgb(255, 255, 255); border-radius: 7px; padding: 5px 9px; font-size: 11px; font-weight: 650; color: var(--muted); }

.copy-btn:hover { border-color: rgb(189, 195, 211); color: var(--text); }

.steps { counter-reset: s 0; margin: 16px 0px 0px; padding: 0px; list-style: none; }

.steps li { counter-increment: s 1; position: relative; padding: 0px 0px 12px 30px; font-size: 12px; color: var(--muted); }

.steps li::before { content: counter(s); position: absolute; left: 0px; top: 0px; width: 20px; height: 20px; border-radius: 50%; background: var(--purple-soft); color: var(--purple-dark); font-size: 11px; font-weight: 700; display: grid; place-items: center; }

.summary-row { display: flex; align-items: center; gap: 10px; padding: 11px 0px; border-bottom: 1px solid rgb(240, 242, 246); }

.summary-row:last-child { border-bottom: 0px; }

