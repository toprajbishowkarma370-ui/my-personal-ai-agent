@charset "utf-8";

:root { --bg: #f5f7fb; --panel: #ffffff; --panel-soft: #f8faff; --line: #e5e9f2; --text: #111827; --muted: #68738a; --subtle: #98a2b3; --navy: #0e1528; --navy-2: #16203a; --purple: #5b52d6; --purple-dark: #473fbb; --purple-soft: #eeecff; --cyan: #12a5c4; --green: #178a5c; --green-soft: #e7f6ee; --orange: #c9762a; --orange-soft: #fdf1e4; --red: #c44d5b; --red-soft: #fdedef; --shadow: 0 18px 50px rgba(22, 30, 58, .08); --shadow-sm: 0 5px 18px rgba(22, 30, 58, .06); --radius: 16px; --ease: cubic-bezier(.22,.68,.24,1); }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: radial-gradient(1100px 520px at 88% -12%, rgba(91,82,214,.09), transparent 62%),
    radial-gradient(900px 460px at -10% 8%, rgba(18,165,196,.08), transparent 60%),
    var(--bg); color: var(--text); font: 14px / 1.55 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }

button, input, textarea, select { font: inherit; }

button { cursor: pointer; }

code, pre, .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; }

.sprite { position: absolute; width: 0px; height: 0px; overflow: hidden; }

.icon { width: 18px; height: 18px; stroke: currentcolor; fill: none; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; flex: 0 0 auto; }

.icon.sm { width: 15px; height: 15px; }

.icon.lg { width: 22px; height: 22px; }

.app { min-height: 100vh; display: flex; }

.sidebar { width: 262px; min-height: 100vh; background: linear-gradient(180deg, var(--navy), #0b1122 62%, #0a1020); color: rgb(255, 255, 255); padding: 25px 15px 18px; display: flex; flex-direction: column; position: fixed; inset: 0px auto 0px 0px; z-index: 30; }

.brand { display: flex; align-items: center; gap: 11px; padding: 0px 11px 26px; }

.brand-mark { width: 36px; height: 36px; border-radius: 11px; display: grid; place-items: center; background: linear-gradient(140deg, rgb(111, 102, 232), rgb(23, 179, 207)); box-shadow: rgba(91, 82, 214, 0.42) 0px 10px 26px; color: rgb(255, 255, 255); position: relative; overflow: hidden; }

.brand-mark::after { content: ""; position: absolute; inset: -40% -120%; background: linear-gradient(105deg, transparent 42%, rgba(255, 255, 255, 0.55) 50%, transparent 58%); animation: sheen 5.5s var(--ease) infinite; }

@keyframes sheen { 
  0% { transform: translateX(-70%); }
  55%, 100% { transform: translateX(80%); }
}

.brand strong { display: block; font-size: 14px; letter-spacing: -0.2px; }

.brand span { display: block; color: rgb(142, 154, 194); font-size: 11px; margin-top: 1px; letter-spacing: 0.04em; }

.nav-label { color: rgb(107, 119, 160); text-transform: uppercase; letter-spacing: 0.12em; font-size: 10px; padding: 15px 12px 8px; }

.nav { display: grid; gap: 3px; }

.nav button { border: 0px; color: rgb(166, 176, 207); background: transparent; text-align: left; padding: 11px 12px; border-radius: 11px; display: flex; align-items: center; gap: 12px; transition: background .22s var(--ease), color .22s var(--ease), transform .22s var(--ease); width: 100%; position: relative; overflow: hidden; }

.nav button::before { content: ""; position: absolute; left: 0px; top: 12%; bottom: 12%; width: 3px; border-radius: 3px; background: linear-gradient(rgb(123, 114, 240), rgb(34, 188, 216)); opacity: 0; transform: scaleY(0.3); transition: opacity .3s var(--ease), transform .3s var(--ease); }

.nav button:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.07); transform: translateX(2px); }

.nav button.active { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); }

.nav button.active::before { opacity: 1; transform: scaleY(1); }

.nav-badge { margin-left: auto; font-size: 10px; padding: 2px 7px; border-radius: 20px; background: rgba(123, 114, 240, 0.28); color: rgb(214, 210, 255); letter-spacing: 0.05em; }

.sidebar-bottom { margin-top: auto; }

.upgrade { margin: 18px 7px; padding: 15px; border-radius: 14px; background: linear-gradient(150deg, rgba(123, 114, 240, 0.2), rgba(23, 179, 207, 0.12)); border: 1px solid rgba(255, 255, 255, 0.09); position: relative; overflow: hidden; }

.upgrade small { color: rgb(184, 193, 230); }

.upgrade b { display: block; margin: 7px 0px 11px; font-size: 13px; }

.upgrade button { width: 100%; border: 0px; border-radius: 9px; padding: 9px; color: rgb(255, 255, 255); background: linear-gradient(135deg, rgb(111, 102, 232), rgb(76, 69, 198)); transition: transform .2s var(--ease), box-shadow .2s; }

.upgrade button:hover { transform: translateY(-2px); box-shadow: rgba(111, 102, 232, 0.4) 0px 10px 22px; }

.profile { border-top: 1px solid rgba(255, 255, 255, 0.08); padding: 16px 8px 3px; display: flex; align-items: center; gap: 9px; }

.avatar { width: 32px; height: 32px; display: grid; place-items: center; border-radius: 50%; background: linear-gradient(140deg, rgb(232, 195, 156), rgb(201, 143, 106)); color: rgb(76, 44, 28); font-weight: 700; font-size: 12px; }

.profile div:nth-child(2) { flex: 1 1 0%; }

.profile strong { font-size: 12px; display: block; }

.profile small { color: rgb(135, 145, 182); font-size: 10px; }

.main { width: calc(100% - 262px); margin-left: 262px; }

.topbar { height: 70px; background: rgba(255, 255, 255, 0.82); backdrop-filter: blur(14px); border-bottom: 1px solid var(--line); padding: 0px 34px; display: flex; align-items: center; justify-content: space-between; position: sticky; top: 0px; z-index: 20; }

.topbar-left { display: flex; align-items: center; gap: 6px; }

.breadcrumb { color: var(--muted); font-size: 13px; }

.breadcrumb b { color: var(--text); font-weight: 650; }

.top-actions { display: flex; align-items: center; gap: 12px; }

.icon-btn { position: relative; border: 0px; background: transparent; color: var(--muted); padding: 8px; border-radius: 9px; transition: background 0.2s, color 0.2s; }

.icon-btn:hover { background: var(--purple-soft); color: var(--purple-dark); }

.dot { width: 7px; height: 7px; background: var(--red); border-radius: 50%; position: absolute; right: 6px; top: 5px; border: 1.5px solid rgb(255, 255, 255); }

.help { border: 1px solid var(--line); border-radius: 9px; color: var(--muted); padding: 8px 12px; background: rgb(255, 255, 255); transition: 0.2s; }

.help:hover { border-color: rgb(195, 201, 216); color: var(--text); }

.scroll-progress { position: absolute; left: 0px; bottom: -1px; height: 2px; width: 0%; background: linear-gradient(90deg, var(--purple), var(--cyan)); transition: width 0.12s linear; }

.page { padding: 32px 34px 60px; max-width: 1540px; margin: auto; }

.view { display: none; }

.view.active { display: block; }

.reveal { opacity: 0; transform: translateY(18px); transition-property: ; transition-duration: ; transition-timing-function: ; transition-behavior: ; transition-delay: var(--d, 0ms); }

.reveal.in { opacity: 1; transform: none; }

.float { animation: 7s ease-in-out 0s infinite normal none running float; }

@keyframes float { 
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}

@keyframes rise { 
  0% { opacity: 0; transform: translateY(9px); }
  100% { opacity: 1; transform: none; }
}

.view.active .page-head { animation: rise .5s var(--ease) both; }

.page-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; margin-bottom: 28px; flex-wrap: wrap; }

h1 { margin: 0px 0px 6px; font-size: 30px; letter-spacing: -0.9px; line-height: 1.18; }

h2 { margin: 0px; font-size: 18px; letter-spacing: -0.35px; }

h3 { margin: 0px; font-size: 14px; }

.subtitle { color: var(--muted); margin: 0px; max-width: 68ch; }

.kinetic span { display: inline-block; opacity: 0; transform: translateY(16px) rotate(2deg); animation: wordIn .72s var(--ease) forwards; }

@keyframes wordIn { 
  100% { opacity: 1; transform: none; }
}

.primary, .secondary, .download-btn-hero { border: 0px; border-radius: 10px; padding: 11px 16px; font-weight: 650; letter-spacing: -0.1px; transition: transform .22s var(--ease), box-shadow .22s var(--ease), background .22s, border-color .22s; display: inline-flex; align-items: center; justify-content: center; gap: 8px; text-decoration: none; position: relative; overflow: hidden; }

.primary { color: rgb(255, 255, 255); background: linear-gradient(135deg, rgb(98, 89, 224), rgb(75, 67, 194)); box-shadow: rgba(91, 82, 214, 0.26) 0px 10px 22px; }

.primary:hover { transform: translateY(-2px); box-shadow: rgba(91, 82, 214, 0.32) 0px 16px 30px; }

.primary::after { content: ""; position: absolute; inset: 0px -60%; transform: translateX(-110%); background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.32), transparent); }

.primary:hover::after { animation: sweep .85s var(--ease) forwards; }

@keyframes sweep { 
  100% { transform: translateX(110%); }
}

.primary:disabled, .secondary:disabled { opacity: 0.6; cursor: not-allowed; transform: none; }

.primary.sm { padding: 8px 12px; font-size: 12px; border-radius: 8px; }

.secondary { color: var(--text); background: rgb(255, 255, 255); border: 1px solid var(--line); }

.secondary:hover { border-color: rgb(185, 192, 209); transform: translateY(-2px); box-shadow: var(--shadow-sm); }

.secondary.sm { padding: 8px 12px; font-size: 12px; border-radius: 8px; }

.card { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); position: relative; }

.card.spotlight::after { content: ""; position: absolute; inset: 0px; border-radius: inherit; pointer-events: none; background: radial-gradient(260px circle at var(--mx,50%) var(--my,50%), rgba(91,82,214,.09), transparent 68%); opacity: 0; transition: opacity .38s var(--ease); }

.card.spotlight:hover::after { opacity: 1; }

.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 20px; }

.stat { padding: 19px; overflow: hidden; transition: transform .35s var(--ease), box-shadow .35s var(--ease); }

.stat:hover { transform: translateY(-4px); box-shadow: var(--shadow); }

