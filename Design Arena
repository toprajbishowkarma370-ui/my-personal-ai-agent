@charset "utf-8";

:root { --bg: #f4f6fb; --panel: #fff; --panel-soft: #f8faff; --line: #e5e9f2; --text: #111827; --muted: #68738a; --subtle: #98a2b3; --navy: #10172e; --navy2: #171d3b; --purple: #6957f5; --purple-dark: #5544dd; --purple-soft: #f0edff; --cyan: #21b7d7; --green: #16a34a; --green-soft: #eaf8f1; --orange: #d97706; --orange-soft: #fff5e9; --red: #dc2626; --red-soft: #fdecef; --shadow: 0 18px 50px rgba(22,30,58,.08); --shadow-sm: 0 5px 18px rgba(22,30,58,.06); --radius: 16px; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--bg); color: var(--text); font: 14px / 1.55 Inter, ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; }

button, input, textarea, select { font: inherit; }

button { cursor: pointer; }

code, pre, .mono { font-family: "JetBrains Mono", ui-monospace, Menlo, Consolas, monospace; }

.app { min-height: 100vh; display: flex; }

.sidebar { width: 270px; min-height: 100vh; background: linear-gradient(rgb(16, 23, 46) 0%, rgb(20, 27, 58) 60%, rgb(26, 33, 80) 100%); color: rgb(255, 255, 255); padding: 24px 14px 16px; display: flex; flex-direction: column; position: fixed; inset: 0px auto 0px 0px; z-index: 30; border-right: 1px solid rgb(35, 43, 85); }

.brand { display: flex; align-items: center; gap: 11px; padding: 2px 11px 22px; }

.brand-mark { width: 38px; height: 38px; border-radius: 12px; display: grid; place-items: center; background: linear-gradient(135deg, rgb(142, 125, 255), rgb(53, 204, 226)); box-shadow: rgba(112, 99, 255, 0.5) 0px 0px 28px; font-weight: 800; font-size: 18px; }

.brand strong { display: block; font-size: 14px; letter-spacing: -0.2px; }

.brand span { display: block; color: rgb(157, 166, 199); font-size: 11px; margin-top: 1px; }

.live-dot { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; color: rgb(110, 231, 183); background: rgba(52, 211, 153, 0.12); border: 1px solid rgba(52, 211, 153, 0.25); padding: 4px 9px; border-radius: 20px; margin: 0px 11px 6px; }

.live-dot i { width: 7px; height: 7px; border-radius: 50%; background: rgb(52, 211, 153); box-shadow: rgb(52, 211, 153) 0px 0px 10px; animation: 2s ease 0s infinite normal none running pulse; }

@keyframes pulse { 
  50% { opacity: 0.4; }
}

.nav-label { color: rgb(105, 116, 152); text-transform: uppercase; letter-spacing: 0.11em; font-size: 10px; padding: 14px 12px 8px; }

.nav { display: grid; gap: 4px; }

.nav button { border: 0px; color: rgb(170, 178, 204); background: transparent; text-align: left; padding: 11px 12px; border-radius: 10px; display: flex; align-items: center; gap: 12px; transition: 0.2s; width: 100%; font-weight: 500; }

.nav button:hover, .nav button.active { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.09); }

.nav button.active { box-shadow: inset 3px 0 var(--purple); }

.icon { width: 18px; height: 18px; display: inline-grid; place-items: center; font-size: 16px; }

.nav-badge { margin-left: auto; font-size: 10px; padding: 2px 7px; border-radius: 20px; background: rgb(49, 46, 105); color: rgb(212, 206, 255); font-weight: 700; }

.sidebar-bottom { margin-top: auto; }

.upgrade { margin: 16px 7px; padding: 15px; border-radius: 13px; background: linear-gradient(145deg, rgb(35, 42, 85), rgb(26, 32, 66)); border: 1px solid rgb(52, 59, 105); }

.upgrade small { color: rgb(174, 184, 222); }

.upgrade b { display: block; margin: 7px 0px 11px; font-size: 13px; }

