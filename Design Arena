.toast.show { transform: none; opacity: 1; }

.mobile-menu { display: none; border: 0px; background: none; font-size: 22px; }

.scrim { display: none; position: fixed; inset: 0px; background: rgba(8, 12, 28, 0.5); z-index: 20; }

.scrim.open { display: block; }

.security-banner { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; margin-bottom: 20px; flex-wrap: wrap; }

.security-banner .lock { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: var(--green-soft); color: var(--green); font-size: 18px; flex: 0 0 auto; }

.security-banner b { display: block; font-size: 13px; margin-bottom: 3px; }

.security-banner span { color: var(--muted); font-size: 12px; }

.security-banner code { background: rgb(238, 241, 249); padding: 1px 5px; border-radius: 5px; font-size: 11px; color: rgb(63, 74, 107); }

.integrations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }

.integration-card { padding: 18px; display: flex; flex-direction: column; }

.int-head { display: flex; gap: 11px; align-items: flex-start; }

.int-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; font-size: 17px; background: var(--purple-soft); flex: 0 0 auto; }

.int-head b { display: block; font-size: 13px; }

.int-head span { display: block; color: var(--muted); font-size: 11px; margin-top: 2px; }

.int-body { margin-top: 14px; }

.int-meta { list-style: none; margin: 0px; padding: 0px; border-top: 1px solid rgb(240, 242, 246); }

.int-meta li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0px; border-bottom: 1px solid rgb(246, 247, 251); font-size: 11px; color: var(--muted); align-items: center; }

.int-meta li b { color: var(--text); font-weight: 600; font-family: ui-monospace, monospace; font-size: 11px; }

.int-actions { display: flex; gap: 8px; margin-top: 15px; flex-wrap: wrap; }

.int-actions button { flex: 1 1 auto; }

.conn-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; padding: 5px 9px; border-radius: 20px; background: rgb(241, 243, 248); color: var(--muted); white-space: nowrap; letter-spacing: 0.01em; }

.conn-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentcolor; flex: 0 0 auto; }

.conn-pill[data-state="connected"] { background: var(--green-soft); color: var(--green); }

.conn-pill[data-state="not-configured"] { background: rgb(241, 243, 248); color: var(--muted); }

.conn-pill[data-state="needs-authorization"] { background: var(--orange-soft); color: var(--orange); }

.conn-pill[data-state="error"] { background: var(--red-soft); color: var(--red); }

.conn-pill[data-state="unreachable"] { background: var(--red-soft); color: var(--red); }

.conn-pill[data-state="checking"] { background: var(--purple-soft); color: var(--purple-dark); }

.verify-log { background: rgb(13, 18, 36); color: rgb(203, 213, 225); border-radius: 12px; padding: 14px 16px; font-size: 11.5px; line-height: 1.7; overflow: auto; max-height: 260px; margin: 14px 0px 0px; white-space: pre-wrap; word-break: break-word; }

.env-row { display: flex; align-items: center; gap: 10px; background: rgb(247, 248, 252); border: 1px solid var(--line); border-radius: 9px; padding: 9px 11px; margin-top: 8px; }

