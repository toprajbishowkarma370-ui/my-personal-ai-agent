.editor-tab { padding: 9px 16px; font-family: ui-monospace, monospace; font-size: 11px; color: rgb(148, 163, 184); border-right: 1px solid rgb(31, 42, 76); border-top: 2px solid transparent; cursor: pointer; background: rgb(9, 13, 28); white-space: nowrap; }

.editor-tab.active { background: rgb(13, 18, 36); color: rgb(241, 245, 249); border-top-color: rgb(105, 87, 245); }

.code-display { flex: 1 1 0%; padding: 16px 20px; margin: 0px; font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace; font-size: 12px; line-height: 1.65; color: rgb(226, 232, 240); overflow: auto; max-height: 500px; white-space: pre-wrap; word-break: break-word; }

.chat-layout { display: grid; grid-template-columns: minmax(0px, 1fr) 330px; gap: 20px; }

.chat-preview { min-height: 540px; display: flex; flex-direction: column; background: rgb(255, 255, 255); overflow: hidden; }

.chat-head { background: linear-gradient(120deg, rgb(23, 29, 59), rgb(64, 56, 152)); color: white; padding: 18px; display: flex; align-items: center; gap: 11px; }

.bot { width: 36px; height: 36px; display: grid; place-items: center; background: rgb(117, 227, 223); color: rgb(21, 32, 68); border-radius: 12px; font-weight: 800; flex: 0 0 auto; }

.chat-head b { display: block; font-size: 13px; }

.chat-head span { color: rgb(196, 201, 236); font-size: 11px; }

.chat-body { flex: 1 1 0%; padding: 22px; background: rgb(247, 248, 252); overflow-y: auto; max-height: 420px; }

.bubble { max-width: 75%; padding: 11px 13px; font-size: 12px; margin-bottom: 12px; border-radius: 13px 13px 13px 3px; background: rgb(255, 255, 255); border: 1px solid var(--line); }

.bubble.user { margin-left: auto; background: var(--purple); color: white; border: 0px; border-radius: 13px 13px 3px; }

.chat-input { display: flex; gap: 8px; padding: 14px; border-top: 1px solid var(--line); }

.chat-input input { padding: 9px; }

.chat-input button { border: 0px; border-radius: 8px; background: var(--purple); color: white; padding: 0px 14px; }

.side-stack { display: grid; gap: 15px; align-content: start; }

.side-stack .card { padding: 18px; }

.channel { display: flex; align-items: center; gap: 10px; padding: 11px 0px; border-bottom: 1px solid rgb(240, 242, 246); }

.channel:last-child { border: 0px; }

.channel-icon { width: 30px; height: 30px; background: rgb(240, 242, 247); border-radius: 8px; display: grid; place-items: center; flex: 0 0 auto; }

.channel div:nth-child(2) { flex: 1 1 0%; }

.channel b { font-size: 12px; display: block; }

.channel span { font-size: 10px; color: var(--muted); }

.modal-backdrop { display: none; position: fixed; inset: 0px; z-index: 60; background: rgba(12, 17, 38, 0.54); align-items: center; justify-content: center; padding: 20px; overflow-y: auto; }

.modal-backdrop.open { display: flex; }

.modal { max-width: 470px; width: 100%; background: white; border-radius: 16px; box-shadow: var(--shadow); padding: 23px; animation: 0.25s ease 0s 1 normal none running rise; }

.modal.wide { max-width: 640px; }

.modal-head { display: flex; justify-content: space-between; margin-bottom: 4px; gap: 12px; align-items: flex-start; }

.close { border: 0px; background: none; font-size: 20px; color: var(--muted); line-height: 1; }

.modal .primary { margin-top: 18px; width: 100%; }

.toast { position: fixed; right: 22px; bottom: 22px; background: var(--navy); color: white; border-radius: 10px; padding: 12px 16px; box-shadow: var(--shadow); transform: translateY(80px); opacity: 0; transition: 0.25s; z-index: 80; font-size: 12px; display: flex; align-items: center; gap: 10px; max-width: calc(-44px + 100vw); }

.toast.show { transform: none; opacity: 1; }

.mobile-menu { display: none; border: 0px; background: none; font-size: 22px; }

.scrim { display: none; position: fixed; inset: 0px; background: rgba(8, 12, 28, 0.5); z-index: 20; }

.scrim.open { display: block; }

.security-banner { display: flex; gap: 14px; align-items: flex-start; padding: 18px 20px; margin-bottom: 20px; flex-wrap: wrap; }

.security-banner .lock { width: 38px; height: 38px; border-radius: 11px; display: grid; place-items: center; background: var(--green-soft); color: var(--green); font-size: 18px; flex: 0 0 auto; }

.security-banner b { display: block; font-size: 13px; margin-bottom: 3px; }

.security-banner span { color: var(--muted); font-size: 12px; }

.security-banner code { background: rgb(238, 241, 249); padding: 1px 5px; border-radius: 5px; font-size: 11px; color: rgb(63, 74, 107); }

.integrations-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 15px; }

.integration-card { padding: 18px; display: flex; flex-direction: column; }

.int-head { display: flex; gap: 11px; align-items: flex-start; }

.int-icon { width: 36px; height: 36px; border-radius: 10px; display: grid; place-items: center; font-size: 17px; background: var(--purple-soft); flex: 0 0 auto; }

.int-head b { display: block; font-size: 13px; }

.int-head span { display: block; color: var(--muted); font-size: 11px; margin-top: 2px; }

.int-body { margin-top: 14px; }

.int-meta { list-style: none; margin: 0px; padding: 0px; border-top: 1px solid rgb(240, 242, 246); }

.int-meta li { display: flex; justify-content: space-between; gap: 10px; padding: 8px 0px; border-bottom: 1px solid rgb(246, 247, 251); font-size: 11px; color: var(--muted); }

.int-meta li b { color: var(--text); font-weight: 600; font-family: ui-monospace, monospace; font-size: 11px; }

.int-actions { display: flex; gap: 8px; margin-top: 15px; flex-wrap: wrap; }

.int-actions button { flex: 1 1 auto; }

.conn-pill { display: inline-flex; align-items: center; gap: 6px; font-size: 10px; font-weight: 700; padding: 5px 9px; border-radius: 20px; background: rgb(241, 243, 248); color: var(--muted); white-space: nowrap; letter-spacing: 0.01em; }

.conn-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentcolor; flex: 0 0 auto; }

.conn-pill[data-state="connected"] { background: var(--green-soft); color: var(--green); }

.conn-pill[data-state="not-configured"] { background: rgb(241, 243, 248); color: var(--muted); }

.conn-pill[data-state="needs-authorization"] { background: var(--orange-soft); color: var(--orange); }

.conn-pill[data-state="error"] { background: var(--red-soft); color: var(--red); }

.conn-pill[data-state="unreachable"] { background: var(--red-soft); color: var(--red); }

.conn-pill[data-state="checking"] { background: var(--purple-soft); color: var(--purple-dark); }

.verify-log { background: rgb(13, 18, 36); color: rgb(203, 213, 225); border-radius: 12px; padding: 14px 16px; font-size: 11.5px; line-height: 1.7; overflow: auto; max-height: 260px; margin: 14px 0px 0px; white-space: pre-wrap; word-break: break-word; }

.env-row { display: flex; align-items: center; gap: 10px; background: rgb(247, 248, 252); border: 1px solid var(--line); border-radius: 9px; padding: 9px 11px; margin-top: 8px; }

.env-row code { flex: 1 1 0%; font-size: 11.5px; color: rgb(48, 58, 92); word-break: break-all; }

.env-row code em { color: var(--subtle); font-style: normal; }

.copy-btn { border: 1px solid var(--line); background: rgb(255, 255, 255); border-radius: 7px; padding: 5px 9px; font-size: 11px; font-weight: 650; color: var(--muted); }

.copy-btn:hover { border-color: rgb(189, 195, 211); color: var(--text); }

.steps { counter-reset: s 0; margin: 16px 0px 0px; padding: 0px; list-style: none; }

.steps li { counter-increment: s 1; position: relative; padding: 0px 0px 12px 30px; font-size: 12px; color: var(--muted); }

.steps li::before { content: counter(s); position: absolute; left: 0px; top: 0px; width: 20px; height: 20px; border-radius: 50%; background: var(--purple-soft); color: var(--purple-dark); font-size: 11px; font-weight: 700; display: grid; place-items: center; }

.summary-row { display: flex; align-items: center; gap: 10px; padding: 11px 0px; border-bottom: 1px solid rgb(240, 242, 246); }

.summary-row:last-child { border-bottom: 0px; }

.summary-row .int-icon { width: 30px; height: 30px; font-size: 14px; }

.summary-row div { flex: 1 1 0%; }

.summary-row b { font-size: 12px; display: block; }

.summary-row span { font-size: 10px; color: var(--muted); }

.pipeline-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 24px; }

.pipeline-step { background: rgb(255, 255, 255); border: 1px solid var(--line); border-radius: 12px; padding: 15px; position: relative; overflow: hidden; transition: 0.2s; }

.pipeline-step.done { border-color: var(--green); background: var(--green-soft); }

.pipeline-step.active { border-color: var(--purple); background: var(--purple-soft); box-shadow: rgba(105, 87, 245, 0.15) 0px 4px 14px; }

.pipeline-step.blocked { border-color: var(--orange); background: var(--orange-soft); }

.pipeline-step small { color: var(--muted); font-size: 10px; text-transform: uppercase; font-weight: 700; letter-spacing: 0.08em; }

.pipeline-step b { display: block; font-size: 13px; margin: 5px 0px 0px; }

.pipeline-step .pStatus { font-size: 11px; color: var(--text); margin-top: 8px; font-weight: 600; display: flex; align-items: center; gap: 5px; }

.workflow-layout { display: grid; grid-template-columns: 1.5fr 1fr; gap: 20px; }

.approval-card { border: 1px solid var(--line); border-radius: 12px; padding: 16px; background: rgb(255, 255, 255); margin-bottom: 12px; }

.approval-card.blocked { border-color: var(--red); background: rgb(255, 245, 245); }

.approval-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; margin-bottom: 10px; }

.approval-head b { font-size: 13px; display: block; }

.approval-head span { font-size: 11px; color: var(--muted); }

.approval-actions { display: flex; gap: 8px; margin-top: 12px; }

.task-item { display: flex; align-items: flex-start; gap: 12px; padding: 14px 0px; border-bottom: 1px solid rgb(240, 242, 246); }

.task-item:last-child { border-bottom: 0px; }

.task-icon { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: rgb(240, 242, 247); font-size: 14px; flex: 0 0 auto; }

.task-info { flex: 1 1 0%; }

.task-info b { display: block; font-size: 13px; }

.task-info span { font-size: 11px; color: var(--muted); }

@media (max-width: 1050px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
  .projects { grid-template-columns: repeat(2, 1fr); }
  .integrations-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-grid, .builder-layout, .workflow-layout { grid-template-columns: 1fr; }
  .code-body-grid { grid-template-columns: 1fr; }
  .file-tree { border-right: 0px; border-bottom: 1px solid rgb(32, 43, 77); max-height: 210px; }
}

@media (max-width: 760px) {
  .sidebar { transform: translateX(-100%); transition: 0.25s; box-shadow: var(--shadow); }
  .sidebar.open { transform: none; }
  .main { width: 100%; margin-left: 0px; }
  .topbar { height: 62px; padding: 0px 17px; }
  .mobile-menu { display: block; margin-right: 10px; }
  .topbar-left { display: flex; align-items: center; }
  .help { display: none; }
  .page { padding: 23px 16px 40px; }
  .page-head { display: block; }
  .page-head .primary { margin-top: 17px; }
  .page-head div:last-child { margin-top: 14px; }
  h1 { font-size: 24px; }
  .stats { gap: 10px; }
  .stat { padding: 14px; }
  .stat b { font-size: 22px; }
  .projects { grid-template-columns: 1fr; }
  .integrations-grid { grid-template-columns: 1fr; }
  .workflow { grid-template-columns: repeat(3, 1fr); row-gap: 15px; }
  .chat-layout { grid-template-columns: 1fr; }
  .choice-grid { grid-template-columns: 1fr; }
  .top-actions { gap: 8px; }
  .code-head { flex-direction: column; align-items: flex-start; }
  .code-actions { width: 100%; }
  .download-zip-btn { width: 100%; justify-content: center; }
  .ghost-dark { flex: 1 1 0%; justify-content: center; }
  .toast { left: 16px; right: 16px; bottom: 16px; }
}
