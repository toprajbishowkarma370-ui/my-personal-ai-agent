/* ============================================================
   ZIP EXPORT CONTROLLER — Real download for mobile Chrome
   ============================================================ */
const ZipExport = (function () {
  let cachedBlob = null;
  let cachedName = null;
  let building = false;

  function setStatus(msg, type) {
    const el = document.getElementById('zipStatus');
    if (el) {
      el.textContent = msg;
      el.classList.remove('hidden');
      el.classList.remove('text-emerald-400', 'text-rose-400', 'text-slate-400', 'text-amber-400');
      el.classList.add(type === 'success' ? 'text-emerald-400' : type === 'error' ? 'text-rose-400' : 'text-amber-400');
    }
  }

  function validateInventory() {
    const paths = Object.keys(PROJECT_FILES);
    if (!paths.length) throw new Error('Inventory empty — no files defined');
    const invalid = paths.filter(p => typeof PROJECT_FILES[p] !== 'string' || PROJECT_FILES[p].length === 0);
    if (invalid.length) throw new Error('Invalid file content: ' + invalid.join(', '));
    return paths;
  }

  async function buildZip() {
    if (typeof JSZip === 'undefined') {
      throw new Error('JSZip library failed to load — check network and reload the page.');
    }
    const paths = validateInventory();
    const zip = new JSZip();
    paths.forEach(p => zip.file(p, PROJECT_FILES[p]));
    // Add a top-level marker for clarity
    zip.file('.project-export-info.txt',
      'My Personal AI Business Agent — EXCLUDED SECRETS\n' +
      'Generated: ' + new Date().toISOString() + '\n' +
      'Files: ' + paths.length + '\n' +
      'Secrets (.env, tokens, hashes) are intentionally excluded.\n' +
      'Copy .env.example to .env.local and populate server-side only.\n'
    );
    const blob = await zip.generateAsync({
      type: 'blob',
      compression: 'DEFLATE',
      compressionOptions: { level: 6 },
      mimeType: 'application/zip'
    });
    if (!blob || blob.size === 0) throw new Error('ZIP blob is empty');
    return { blob, name: 'my-personal-ai-business-agent-v3.6.0.zip', count: paths.length };
  }

  function triggerDownload(blob, filename) {
    // IE/old Edge
    if (window.navigator && window.navigator.msSaveOrOpenBlob) {
      window.navigator.msSaveOrOpenBlob(blob, filename);
      return true;
    }
    // Modern browsers (Chrome desktop + mobile, Safari, Edge, Firefox)
    let blobUrl;
    try {
      blobUrl = URL.createObjectURL(blob);
    } catch (e) {
      throw new Error('URL.createObjectURL failed: ' + e.message);
    }

    const a = document.createElement('a');
    a.href = blobUrl;
    a.download = filename;
    a.rel = 'noopener';
    a.style.display = 'none';
    a.style.position = 'absolute';
    a.style.left = '-9999px';
    document.body.appendChild(a);

    // Prefer native click for mobile Chrome (inside user gesture chain)
    let clicked = false;
    try {
      if (typeof a.click === 'function') {
        a.click();
        clicked = true;
      }
    } catch (e) { /* fall through */ }

    if (!clicked) {
      try {
        const evt = new MouseEvent('click', { bubbles: true, cancelable: true, view: window });
        a.dispatchEvent(evt);
        clicked = true;
      } catch (e) {
        try {
          const evt = document.createEvent('MouseEvents');
          evt.initMouseEvent('click', true, true, window, 0, 0, 0, 0, 0, false, false, false, false, 0, null);
          a.dispatchEvent(evt);
          clicked = true;
        } catch (e2) {
          clicked = false;
        }
      }
    }

    // Cleanup after a delay so mobile Chrome can complete the download
    setTimeout(() => {
      try { document.body.removeChild(a); } catch (e) { }
      try { URL.revokeObjectURL(blobUrl); } catch (e) { }
    }, 6000);

    if (!clicked) throw new Error('Browser refused to trigger download (unsupported anchor click)');
    return true;
  }

  async function download(ev) {
    if (ev) { ev.preventDefault(); ev.stopPropagation(); }
    if (building) return;
    building = true;
    const buttons = document.querySelectorAll('.download-all-btn');
    buttons.forEach(b => { b.setAttribute('disabled', 'disabled'); b.style.opacity = '0.7'; });

    try {
      setStatus('🔍 Validating project inventory…', 'info');
      validateInventory();

      let blob = cachedBlob;
      let name = cachedName;

      if (!blob) {
        setStatus('📦 Building ZIP archive…', 'info');
        const built = await buildZip();
        blob = built.blob;
        name = built.name;
        cachedBlob = blob;
        cachedName = name;
      }

      setStatus('⬇ Triggering browser download…', 'info');
      triggerDownload(blob, name);

      const kb = (blob.size / 1024).toFixed(1);
      setStatus('✓ Download started — ' + kb + ' KB — ' + name, 'success');
      showToast('✓ ZIP download started (' + kb + ' KB)', 'success');
    } catch (err) {
      console.error('[ZIP Export] failed:', err);
      const msg = (err && err.message) ? err.message : 'Unknown error';
      setStatus('✗ Export failed: ' + msg, 'error');
      showToast('✗ ZIP export failed: ' + msg, 'error');
    } finally {
      building = false;
      buttons.forEach(b => { b.removeAttribute('disabled'); b.style.opacity = '1'; });
    }
  }

  function warm() {
    if (cachedBlob) return;
    buildZip().then(({ blob, name }) => {
      cachedBlob = blob;
      cachedName = name;
      console.log('[ZIP Export] Pre-built ' + name + ' (' + blob.size + ' bytes)');
    }).catch(err => {
      console.warn('[ZIP Export] Pre-build skipped (will retry on click):', err.message);
    });
  }

  function attach() {
    const buttons = document.querySelectorAll('.download-all-btn');
    buttons.forEach(btn => {
      btn.type = 'button';
      btn.addEventListener('click', download);
    });
    // Pre-warm cache so first click completes within the user gesture on mobile Chrome
    setTimeout(warm, 500);
  }

  return { attach, download };
})();

