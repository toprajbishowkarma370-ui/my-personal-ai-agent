@charset "utf-8";

:root { --bg: #f4f6f8; --panel: #ffffff; --panel-soft: #f8fafb; --line: #e4e8ed; --line-strong: #d3dae2; --text: #121c26; --muted: #5f6f7f; --subtle: #94a2b1; --ink: #111c24; --ink-2: #17242e; --accent: #d94f2b; --accent-2: #b93f20; --accent-soft: #fdeee9; --teal: #12796a; --teal-soft: #e6f4f1; --amber: #b87613; --amber-soft: #fdf3e2; --red: #c2372c; --red-soft: #fdecea; --blue: #2563a8; --blue-soft: #e9f1fa; --shadow: 0 22px 55px rgba(18,28,38,.10); --shadow-sm: 0 4px 16px rgba(18,28,38,.06); --radius: 18px; --radius-sm: 12px; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--bg); color: var(--text); font: 14px / 1.55 Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; -webkit-font-smoothing: antialiased; overflow-x: hidden; }

button, input, textarea, select { font: inherit; }

button { cursor: pointer; }

code, pre, .mono { font-family: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace; }

a { color: inherit; }

::selection { background: rgb(255, 217, 205); color: rgb(74, 27, 13); }

.app { min-height: 100vh; display: flex; }

.sidebar { width: 262px; min-height: 100vh; background: radial-gradient(1200px 500px at 20% -10%, rgba(217, 79, 43, 0.2), transparent 60%), linear-gradient(rgb(17, 28, 36) 0%, rgb(13, 22, 29) 100%); color: rgb(255, 255, 255); padding: 22px 15px 18px; display: flex; flex-direction: column; position: fixed; inset: 0px auto 0px 0px; z-index: 40; }

.brand { display: flex; align-items: center; gap: 12px; padding: 4px 10px 26px; }

.brand-mark { width: 38px; height: 38px; border-radius: 13px; display: grid; place-items: center; flex: 0 0 auto; background: linear-gradient(140deg, rgb(240, 113, 74), rgb(201, 56, 15)); font-weight: 800; font-size: 16px; box-shadow: rgba(217, 79, 43, 0.42) 0px 10px 26px; animation: 6s ease-in-out 0s infinite normal none running markFloat; }

@keyframes markFloat { 
  0%, 100% { transform: translateY(0px) rotate(0deg); }
  50% { transform: translateY(-4px) rotate(-3deg); }
}

.brand strong { display: block; font-size: 14.5px; letter-spacing: -0.2px; }

.brand span { display: block; color: rgb(143, 162, 177); font-size: 11px; margin-top: 2px; letter-spacing: 0.04em; }

.nav-label { color: rgb(102, 121, 138); text-transform: uppercase; letter-spacing: 0.13em; font-size: 10px; padding: 16px 12px 8px; font-weight: 700; }

.nav { display: grid; gap: 3px; }

.nav button { border: 0px; color: rgb(169, 184, 196); background: transparent; text-align: left; padding: 11px 12px; border-radius: 11px; display: flex; align-items: center; gap: 12px; transition: background 0.22s, color 0.22s, transform 0.22s cubic-bezier(0.2, 0.8, 0.2, 1); width: 100%; position: relative; font-size: 13px; font-weight: 500; }

.nav button:hover { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.075); transform: translateX(3px); }

.nav button.active { color: rgb(255, 255, 255); background: rgba(255, 255, 255, 0.1); }

.nav button.active::before { content: ""; position: absolute; left: 0px; top: 9px; bottom: 9px; width: 3px; border-radius: 0px 4px 4px 0px; background: linear-gradient(rgb(240, 113, 74), rgb(201, 56, 15)); }

.icon { width: 19px; height: 19px; display: inline-grid; place-items: center; flex: 0 0 auto; }

.icon svg { width: 18px; height: 18px; stroke: currentcolor; fill: none; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

.nav-badge { margin-left: auto; font-size: 9.5px; padding: 3px 8px; border-radius: 20px; background: rgb(43, 58, 69); color: rgb(255, 181, 156); font-weight: 700; letter-spacing: 0.06em; }

.sidebar-bottom { margin-top: auto; }

.upgrade { margin: 16px 6px; padding: 16px; border-radius: 15px; background: linear-gradient(150deg, rgb(28, 43, 52), rgb(22, 34, 42)); border: 1px solid rgb(42, 59, 70); position: relative; overflow: hidden; }

.upgrade::after { content: ""; position: absolute; inset: 0px; background: linear-gradient(115deg, transparent 30%, rgba(255, 255, 255, 0.1) 48%, transparent 62%); transform: translateX(-120%); animation: 6.5s ease-in-out 0s infinite normal none running sweep; }

@keyframes sweep { 
  0%, 70% { transform: translateX(-120%); }
  100% { transform: translateX(120%); }
}

.upgrade small { color: rgb(147, 165, 178); font-size: 10.5px; letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700; }

.upgrade b { display: block; margin: 8px 0px 12px; font-size: 13.5px; }

.upgrade button { width: 100%; border: 0px; border-radius: 10px; padding: 9px; color: rgb(255, 255, 255); background: linear-gradient(135deg, rgb(224, 90, 51), rgb(194, 60, 23)); font-weight: 650; font-size: 12.5px; transition: 0.2s; }

.upgrade button:hover { transform: translateY(-1px); box-shadow: rgba(217, 79, 43, 0.35) 0px 8px 20px; }

.profile { border-top: 1px solid rgb(38, 52, 61); padding: 15px 8px 2px; display: flex; align-items: center; gap: 10px; }

