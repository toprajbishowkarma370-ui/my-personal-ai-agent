.ghost-dark { background: rgb(27, 36, 71); color: rgb(203, 213, 225); border: 1px solid rgb(44, 56, 99); border-radius: 8px; padding: 8px 12px; font-size: 12px; font-weight: 600; display: inline-flex; align-items: center; gap: 6px; }

.ghost-dark:hover { background: rgb(36, 48, 92); color: rgb(255, 255, 255); }

.code-body-grid { display: grid; grid-template-columns: 260px 1fr; min-height: 420px; }

.file-tree { background: rgb(9, 14, 31); border-right: 1px solid rgb(32, 43, 77); padding: 12px 8px; font-family: ui-monospace, monospace; font-size: 12px; overflow-y: auto; max-height: 600px; }

.tree-folder { color: rgb(148, 163, 184); padding: 6px 10px; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; font-weight: 700; margin-top: 6px; }

.tree-file { display: flex; align-items: center; gap: 8px; padding: 6px 10px; color: rgb(203, 213, 225); border-radius: 6px; cursor: pointer; user-select: none; transition: 0.15s; }

.tree-file:hover { background: rgb(24, 35, 70); color: rgb(255, 255, 255); }

.tree-file.active { background: rgb(39, 54, 105); color: rgb(56, 189, 248); font-weight: 600; }

.file-icon { font-size: 13px; opacity: 0.8; }

.code-editor-pane { display: flex; flex-direction: column; background: rgb(13, 18, 36); position: relative; min-width: 0px; }

.editor-tabs { display: flex; background: rgb(9, 13, 28); border-bottom: 1px solid rgb(31, 42, 76); overflow-x: auto; }

.editor-tab { padding: 9px 16px; font-family: ui-monospace, monospace; font-size: 11px; color: rgb(148, 163, 184); border-right: 1px solid rgb(31, 42, 76); border-top: 2px solid transparent; background: rgb(9, 13, 28); white-space: nowrap; }

.editor-tab.active { background: rgb(13, 18, 36); color: rgb(241, 245, 249); border-top-color: rgb(105, 87, 245); }

.code-display { flex: 1 1 0%; padding: 16px 20px; margin: 0px; font-family: ui-monospace, monospace; font-size: 12px; line-height: 1.65; color: rgb(226, 232, 240); overflow: auto; max-height: 520px; white-space: pre-wrap; word-break: break-word; }

.chat-layout { display: grid; grid-template-columns: minmax(0px, 1fr) 330px; gap: 20px; }

.chat-preview { min-height: 540px; display: flex; flex-direction: column; background: rgb(255, 255, 255); overflow: hidden; }

.chat-head { background: linear-gradient(120deg, rgb(23, 29, 59), rgb(64, 56, 152)); color: rgb(255, 255, 255); padding: 18px; display: flex; align-items: center; gap: 11px; }

.bot { width: 36px; height: 36px; display: grid; place-items: center; background: rgb(117, 227, 223); color: rgb(21, 32, 68); border-radius: 12px; font-weight: 800; flex: 0 0 auto; }

.chat-head b { display: block; font-size: 13px; }

.chat-head span { color: rgb(196, 201, 236); font-size: 11px; }

.chat-body { flex: 1 1 0%; padding: 22px; background: rgb(247, 248, 252); overflow-y: auto; max-height: 430px; min-height: 320px; }

.bubble { max-width: 78%; padding: 11px 13px; font-size: 12.5px; margin-bottom: 12px; border-radius: 13px 13px 13px 3px; background: rgb(255, 255, 255); border: 1px solid var(--line); line-height: 1.55; }

.bubble.user { margin-left: auto; background: var(--purple); color: rgb(255, 255, 255); border: 0px; border-radius: 13px 13px 3px; }

.bubble.needs-auth { background: rgb(255, 247, 237); border: 1px solid rgb(253, 186, 116); color: rgb(154, 52, 18); font-weight: 650; }

.bubble.typing { color: var(--muted); font-style: italic; }

.chat-input { display: flex; gap: 8px; padding: 14px; border-top: 1px solid var(--line); }

.chat-input input { padding: 9px; }

.chat-input button { border: 0px; border-radius: 8px; background: var(--purple); color: rgb(255, 255, 255); padding: 0px 16px; font-weight: 700; }

.side-stack { display: grid; gap: 15px; align-content: start; }

.side-stack .card { padding: 18px; }

.channel { display: flex; align-items: center; gap: 10px; padding: 11px 0px; border-bottom: 1px solid rgb(240, 242, 246); }

.channel:last-child { border: 0px; }

.channel-icon { width: 30px; height: 30px; background: rgb(240, 242, 247); border-radius: 8px; display: grid; place-items: center; flex: 0 0 auto; }

.channel div:nth-child(2) { flex: 1 1 0%; }

.channel b { font-size: 12px; display: block; }

.channel span { font-size: 10px; color: var(--muted); }

.modal-backdrop { display: none; position: fixed; inset: 0px; z-index: 60; background: rgba(12, 17, 38, 0.54); align-items: center; justify-content: center; padding: 20px; overflow-y: auto; }

.modal-backdrop.open { display: flex; }

.modal { max-width: 470px; width: 100%; background: rgb(255, 255, 255); border-radius: 16px; box-shadow: var(--shadow); padding: 23px; animation: 0.25s ease 0s 1 normal none running rise; }

.modal.wide { max-width: 640px; }

.modal-head { display: flex; justify-content: space-between; margin-bottom: 4px; gap: 12px; align-items: flex-start; }

.close { border: 0px; background: none; font-size: 20px; color: var(--muted); line-height: 1; }

.modal .primary { margin-top: 18px; width: 100%; }

