@charset "utf-8";

body { margin: 0px; font-family: Inter, system-ui, sans-serif; background: rgb(11, 16, 32); color: rgb(226, 232, 240); }

header { padding: 28px; max-width: 900px; margin: auto; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgb(30, 41, 59); }

header b { font-size: 18px; }

nav a { color: rgb(148, 163, 184); text-decoration: none; margin-left: 16px; font-size: 13px; }

.hero { max-width: 900px; margin: 40px auto; padding: 28px; text-align: center; }

.badge { display: inline-flex; gap: 6px; align-items: center; border: 1px solid rgb(51, 65, 85); background: rgb(30, 41, 59); color: rgb(203, 213, 225); border-radius: 20px; padding: 4px 10px; font-size: 11px; }

.hero h1 { font-size: 36px; margin: 18px 0px 10px; letter-spacing: -0.03em; }

.hero p { color: rgb(148, 163, 184); max-width: 600px; margin: auto; }

.cta { display: inline-flex; gap: 10px; margin-top: 22px; }

.btn { padding: 10px 18px; border-radius: 10px; font-weight: 700; text-decoration: none; display: inline-flex; gap: 6px; }

.btn-primary { background: rgb(105, 87, 245); color: rgb(255, 255, 255); }

.btn-ghost { border: 1px solid rgb(51, 65, 85); color: rgb(226, 232, 240); }

.grid { max-width: 900px; margin: 28px auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; padding: 0px 28px; }

.card { border: 1px solid rgb(30, 41, 59); background: rgb(15, 23, 42); border-radius: 14px; padding: 16px; }

.card h3 { margin: 0px 0px 6px; font-size: 13px; }

.card p { margin: 0px; color: rgb(148, 163, 184); font-size: 12px; }

footer { max-width: 900px; margin: 40px auto; padding: 24px 28px; border-top: 1px solid rgb(30, 41, 59); color: rgb(100, 116, 139); font-size: 11px; text-align: center; }

@media (max-width: 700px) {
  .grid { grid-template-columns: 1fr; }
}
