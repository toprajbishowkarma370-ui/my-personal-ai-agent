.code-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

.download-zip-btn { background: linear-gradient(135deg, rgb(16, 185, 129), rgb(5, 150, 105)); color: rgb(255, 255, 255); border: 0px; border-radius: 8px; padding: 8px 16px; font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; gap: 7px; box-shadow: rgba(16, 185, 129, 0.35) 0px 4px 14px; transition: 0.2s; white-space: nowrap; }

