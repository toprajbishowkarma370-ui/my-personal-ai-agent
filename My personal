  };
  container.innerHTML = AppState.integrations.map(cardHtml).join('');
  overview.innerHTML = AppState.integrations.slice(0, 6).map(cardHtml).join('');
}

function renderCRMTBody() {
  const tbody = document.getElementById('crmTableBody');
  tbody.innerHTML = chaurjahariLeadsData.map(l => {
    const tierColor = l.tier === 1 ? 'rose' : l.tier === 2 ? 'amber' : 'slate';
    return '<tr class="hover:bg-slate-50">' +
      '<td class="p-4"><div class="font-bold">' + l.company + '</div><div class="text-[10px] text-slate-500">' + l.type + '</div></td>' +
      '<td class="p-4"><span class="text-[10px] px-2 py-0.5 rounded bg-' + tierColor + '-100 text-' + tierColor + '-700 font-bold">' + l.tierLabel + '</span></td>' +
      '<td class="p-4 font-mono">$' + (1500 - l.rank * 60) + '</td>' +
      '<td class="p-4"><span class="text-[10px] font-bold px-2 py-0.5 rounded bg-amber-100 text-amber-800">WAITING_APPROVAL</span></td>' +
      '<td class="p-4"><div class="flex items-center gap-2"><div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden"><div class="h-full bg-brand-500" style="width:' + l.score + '%"></div></div><span class="font-bold text-xs">' + l.score + '</span></div></td>' +
    '</tr>';
  }).join('');
}

function renderFileTree() {
  const tree = document.getElementById('fileExplorerTree');
  const paths = Object.keys(PROJECT_FILES);
  const folders = {};
  paths.forEach(p => {
    const parts = p.split('/');
    const dir = parts.length > 1 ? parts.slice(0, -1).join('/') : '/';
    if (!folders[dir]) folders[dir] = [];
    folders[dir].push(parts[parts.length - 1]);
  });
  let html = '';
  Object.keys(folders).sort().forEach(dir => {
    html += '<div class="text-[10px] font-bold text-slate-500 uppercase px-2 mt-2">' + (dir === '/' ? 'root' : dir) + '</div>';
    folders[dir].forEach(f => {
      const path = dir === '/' ? f : dir + '/' + f;
      const active = path === AppState.activeFile;
      html += '<button onclick="selectFile(\'' + path.replace(/'/g, "\\'") + '\')" class="w-full text-left px-2 py-1 rounded ' + (active ? 'bg-slate-800 text-white' : 'text-slate-400 hover:bg-slate-800/50') + '">' + f + '</button>';
    });
  });
  tree.innerHTML = html;
}

function renderFileTabs() {
  const tabs = document.getElementById('fileTabs');
  tabs.innerHTML = AppState.openTabs.map(path => {
    const active = path === AppState.activeFile;
    const name = path.split('/').pop();
    return '<button onclick="selectFile(\'' + path.replace(/'/g, "\\'") + '\')" class="px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap ' + (active ? 'bg-brand-600 text-white' : 'bg-slate-800 text-slate-300') + '">' + name + '</button>';
  }).join('');
}

function selectFile(path) {
  AppState.activeFile = path;
  if (!AppState.openTabs.includes(path)) AppState.openTabs.push(path);
  document.getElementById('codeDisplay').textContent = PROJECT_FILES[path] || '// File not found in inventory';
  document.getElementById('activeFilePath').textContent = path;
  const ext = path.split('.').pop();
  document.getElementById('activeFileMeta').textContent = (ext === 'ts' ? 'TypeScript' : ext === 'tsx' ? 'React TSX' : ext === 'prisma' ? 'Prisma Schema' : ext === 'json' ? 'JSON' : 'Text') + ' • Session Checked';
  renderFileTree();
  renderFileTabs();
}

function copyCurrentCode() {
  const code = PROJECT_FILES[AppState.activeFile] || '';
  navigator.clipboard.writeText(code).then(() => {
    showToast('Copied ' + AppState.activeFile, 'success');
    const label = document.getElementById('copyCodeLabel');
    if (label) { label.textContent = 'Copied!'; setTimeout(() => label.textContent = 'Copy', 1500); }
  }).catch(() => showToast('Clipboard not available', 'error'));
}

function openPreviewModal() {
  const iframe = document.getElementById('previewIframe');
  iframe.srcdoc = '<!DOCTYPE html><html><head><script src="https://cdn.tailwindcss.com"><\/script></head><body class="bg-slate-50 flex items-center justify-center min-h-screen p-6"><div class="max-w-2xl text-center"><div class="text-xs font-bold text-brand-600 uppercase mb-2">Reference Preview</div><h1 class="text-4xl font-black text-slate-900 mb-3">Hotel Samjhana Chaurjahari</h1><p class="text-slate-600 mb-6">Modern booking-ready landing page scaffold — Next.js 14 component prepared after owner approval.</p><button class="px-6 py-3 bg-brand-600 text-white rounded-xl font-bold">Book Your Stay</button></div></body></html>';
  document.getElementById('sitePreviewModal').classList.remove('hidden');
  document.getElementById('sitePreviewModal').classList.add('flex');
}
function closePreviewModal() {
  document.getElementById('sitePreviewModal').classList.add('hidden');
  document.getElementById('sitePreviewModal').classList.remove('flex');
}

function openApprovalModal(id) {
  const item = AppState.approvalQueue.find(a => a.id === id);
  if (!item) return;
  AppState.selectedApproval = item;
  document.getElementById('approvalSubjectNp').value = item.subjectNp;
  document.getElementById('approvalSubject').value = item.subjectEn;
  document.getElementById('approvalEmailBodyNp').value = item.bodyNp;
  document.getElementById('approvalEmailBody').value = item.bodyEn;
  document.getElementById('approvalMetaGrid').innerHTML =
    '<div class="p-2 rounded-lg bg-white border"><div class="text-[10px] text-slate-500 uppercase">Action ID</div><div class="font-mono font-bold">' + item.id + '</div></div>' +
    '<div class="p-2 rounded-lg bg-white border"><div class="text-[10px] text-slate-500 uppercase">Business</div><div class="font-bold">' + item.business + '</div></div>' +
    '<div class="p-2 rounded-lg bg-white border"><div class="text-[10px] text-slate-500 uppercase">Provider</div><div class="font-mono text-rose-600 font-bold">RESEND NOT CONNECTED</div></div>' +
    '<div class="p-2 rounded-lg bg-white border"><div class="text-[10px] text-slate-500 uppercase">Status</div><div class="font-mono text-amber-600 font-bold">' + item.status + '</div></div>';
  document.getElementById('ownerApprovalModal').classList.remove('hidden');
  document.getElementById('ownerApprovalModal').classList.add('flex');
}
function closeOwnerApprovalModal() {
  document.getElementById('ownerApprovalModal').classList.add('hidden');
  document.getElementById('ownerApprovalModal').classList.remove('flex');
}
function openNextApproval() {
  const next = AppState.approvalQueue.find(a => a.status === 'WAITING_APPROVAL');
  if (next) openApprovalModal(next.id);
  else showToast('No pending approvals', 'success');
}
function confirmApproveAction() {
  if (!AppState.selectedApproval) return;
  const idx = AppState.approvalQueue.findIndex(a => a.id === AppState.selectedApproval.id);
  if (idx >= 0) AppState.approvalQueue[idx].status = 'AUTHORIZED';
  const badge = document.getElementById('pendingApprovalBadge');
  const count = AppState.approvalQueue.filter(a => a.status === 'WAITING_APPROVAL').length;
  badge.textContent = count + ' Approval';
  renderApprovalQueue();
  closeOwnerApprovalModal();
  showToast('Authorized (dispatch waits for CONNECTED provider)', 'success');
}
function rejectApprovalAction() {
  if (!AppState.selectedApproval) return;
  const idx = AppState.approvalQueue.findIndex(a => a.id === AppState.selectedApproval.id);
  if (idx >= 0) AppState.approvalQueue[idx].status = 'REJECTED';
  renderApprovalQueue();
  closeOwnerApprovalModal();
  showToast('Rejected', 'error');
}

function openNewLeadModal() {
  document.getElementById('newLeadModal').classList.remove('hidden');
  document.getElementById('newLeadModal').classList.add('flex');
}
function closeNewLeadModal() {
  document.getElementById('newLeadModal').classList.add('hidden');
  document.getElementById('newLeadModal').classList.remove('flex');
}
function submitNewLead() {
  const company = document.getElementById('nlCompany').value.trim();
  if (!company) { showToast('Enter a company name', 'error'); return; }
  showToast('Lead saved locally', 'success');
  closeNewLeadModal();
}

function handleChatSubmit(e) {
  e.preventDefault();
  const input = document.getElementById('chatInput');
  const val = input.value.trim();
  if (!val) return;
  const messages = document.getElementById('chatMessages');
  const userMsg = document.createElement('div');
  userMsg.className = 'flex justify-end';
  userMsg.innerHTML = '<div class="bg-brand-600 text-white p-3 rounded-2xl text-xs max-w-md">' + val.replace(/</g, '&lt;') + '</div>';
  messages.appendChild(userMsg);
  input.value = '';
  setTimeout(() => {
    const botMsg = document.createElement('div');
    botMsg.className = 'flex justify-start';
    botMsg.innerHTML = '<div class="bg-slate-900 border border-slate-800 text-slate-300 p-3 rounded-2xl text-xs max-w-md"><div class="font-bold text-brand-300 text-[10px] uppercase mb-1">Master Orchestrator</div><div>Noted. Checking approval queue and task blockers.</div></div>';
    messages.appendChild(botMsg);
    messages.scrollTop = messages.scrollHeight;
  }, 600);
}

function handleLogout() {
  showToast('Signing out (session cleared locally)', 'success');
}

function runPreflightCheck() { showToast('Preflight: 12 providers checked — 0 CONNECTED, 4 NEEDS_AUTHORIZATION, 8 NOT_CONNECTED', 'error'); }
function testAllIntegrations() { showToast('Provider test invoked — no fake success. Connect real keys to flip statuses.', 'success'); }
function retryAllBlocked() { showToast('Blocked tasks re-queued for owner review', 'success'); }

/* INIT */
document.addEventListener('DOMContentLoaded', () => {
  AppState.openTabs = AppState.openTabs.filter(t => PROJECT_FILES[t]);
  if (!PROJECT_FILES[AppState.activeFile]) AppState.activeFile = AppState.openTabs[0];

  renderAgents();
  renderApprovalQueue();
  renderLeadRankTable();
  renderIntegrations();
  renderCRMTBody();
  renderFileTree();
  renderFileTabs();
  selectFile(AppState.activeFile);

  // Attach ZIP export handler to all .download-all-btn buttons
  ZipExport.attach();
  console.log('[App] Ready. Project inventory:', Object.keys(PROJECT_FILES).length, 'files.');
});
</script>
