.task-item:last-child { border-bottom: 0px; }

.task-icon { width: 28px; height: 28px; border-radius: 8px; display: grid; place-items: center; background: rgb(240, 242, 247); font-size: 14px; flex: 0 0 auto; }

.task-info { flex: 1 1 0%; }

.task-info b { display: block; font-size: 13px; }

.task-info span { font-size: 11px; color: var(--muted); }

.backend-banner { display: flex; gap: 12px; align-items: flex-start; border-radius: 12px; padding: 13px 15px; margin-bottom: 14px; font-size: 12px; line-height: 1.55; border: 1px solid; }

.backend-banner.auth { background: rgb(255, 247, 237); border-color: rgb(253, 186, 116); color: rgb(124, 45, 18); }

.backend-banner.live { background: rgb(236, 253, 245); border-color: rgb(110, 231, 183); color: rgb(6, 95, 70); }

.backend-banner.checking { background: rgb(245, 243, 255); border-color: rgb(196, 181, 253); color: rgb(76, 29, 149); }

.backend-banner b { display: block; font-size: 12.5px; margin-bottom: 2px; }

.secure-note { display: flex; gap: 8px; align-items: flex-start; background: rgb(240, 253, 244); border: 1px solid rgb(187, 247, 208); border-radius: 10px; padding: 10px 12px; font-size: 11px; color: rgb(20, 83, 45); margin-top: 12px; }

@media (max-width: 1050px) {
  .stats { grid-template-columns: repeat(2, 1fr); }
  .projects { grid-template-columns: repeat(2, 1fr); }
  .integrations-grid { grid-template-columns: repeat(2, 1fr); }
  .dashboard-grid, .builder-layout, .workflow-layout { grid-template-columns: 1fr; }
  .code-body-grid { grid-template-columns: 1fr; }
  .file-tree { border-right: 0px; border-bottom: 1px solid rgb(32, 43, 77); max-height: 210px; }
}

@media (max-width: 760px) {
  .sidebar { transform: translateX(-100%); transition: 0.25s; box-shadow: var(--shadow); }
  .sidebar.open { transform: none; }
  .main { width: 100%; margin-left: 0px; }
  .topbar { height: 62px; padding: 0px 17px; }
  .mobile-menu { display: block; margin-right: 10px; }
  .topbar-left { display: flex; align-items: center; }
  .help { display: none; }
  .page { padding: 23px 16px 40px; }
  .page-head { display: block; }
  .page-head .primary { margin-top: 17px; }
  .page-head div:last-child { margin-top: 14px; }
  h1 { font-size: 24px; }
  .stats { gap: 10px; }
  .stat { padding: 14px; }
  .stat b { font-size: 22px; }
  .projects { grid-template-columns: 1fr; }
  .integrations-grid { grid-template-columns: 1fr; }
  .workflow { grid-template-columns: repeat(3, 1fr); row-gap: 15px; }
  .chat-layout { grid-template-columns: 1fr; }
  .choice-grid { grid-template-columns: 1fr; }
  .top-actions { gap: 8px; }
  .code-head { flex-direction: column; align-items: flex-start; }
  .code-actions { width: 100%; }
  .download-zip-btn { width: 100%; justify-content: center; }
  .ghost-dark { flex: 1 1 0%; justify-content: center; }
  .toast { left: 16px; right: 16px; bottom: 16px; }
}

.typing-dots span { display: inline-block; width: 6px; height: 6px; background: rgb(165, 180, 252); border-radius: 50%; margin-right: 3px; animation: 1.2s ease 0s infinite normal none running blink; }

.typing-dots span:nth-child(2) { animation-delay: 0.2s; }

.typing-dots span:nth-child(3) { animation-delay: 0.4s; }

@keyframes blink { 
  0%, 80%, 100% { opacity: 0.25; }
  40% { opacity: 1; }
}
