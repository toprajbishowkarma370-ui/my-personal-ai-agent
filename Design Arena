.summary-row div { flex: 1 1 0%; }

.summary-row b { font-size: 12px; display: block; }

.summary-row span { font-size: 10px; color: var(--muted); }

.pipeline-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-bottom: 0px; }

